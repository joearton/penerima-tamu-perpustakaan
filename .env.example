# Integrasi opsional. Salin ke .env, isi yang dibutuhkan, lalu: chmod 600 .env
# Variabel yang dibiarkan kosong = fitur tersebut nonaktif.

# --- Direktori anggota (lookup data anggota saat registrasi) ---
# URL lookup dengan placeholder {nomor}, mis. https://contoh.ac.id/api/members/{nomor}/
DIRECTORY_LOOKUP_URL=
# Kredensial dikirim sebagai header X-API-Key dan X-API-Secret. JANGAN commit/bagikan.
DIRECTORY_API_KEY=
DIRECTORY_API_SECRET=
# Opsional: pencarian untuk auto-complete registrasi (?q=<teks>&limit=<n> ditambahkan otomatis)
DIRECTORY_SEARCH_URL=
# Opsional: daftar foto untuk tebakan identitas saat registrasi (paginasi ?page=&per_page=)
DIRECTORY_FACES_URL=

# --- Login admin via OAuth2 / OpenID Connect (klien public + PKCE, tanpa secret) ---
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_CLIENT_ID=
OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
OAUTH_SCOPE=openid profile email
OAUTH_LABEL=Masuk dengan akun institusi
